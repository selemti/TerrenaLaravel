rce_location": "L21"}, {"caller_nid": "common_helpers_get", "callee": "set", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L66"}, {"caller_nid": "common_helpers_post_form", "callee": "stringify", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L71"}, {"caller_nid": "common_helpers_post_form", "callee": "has", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L72"}, {"caller_nid": "common_helpers_post_form", "callee": "finally", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L75"}, {"caller_nid": "common_helpers_post_form", "callee": "(async()=>{\r\n    const body = new URLSearchParams();\r\n    Object.entries(data||{}).forEach(([k,v])=> body.append(k, String(v ?? '')));\r\n\r\n    log('POST', url, Object.fromEntries(body.entries()));\r\n\r\n    const ctrl = new AbortController();\r\n    const tmr  = setTimeout(()=> ctrl.abort('timeout'), 12000);\r\n\r\n    let r, t, ct;\r\n    try{\r\n      r  = await fetch(url, {\r\n        method:'POST',\r\n        credentials:'same-origin',\r\n        headers:{\r\n          'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8',\r\n          'Accept':'application/json'\r\n        },\r\n        body,\r\n        signal: ctrl.signal\r\n      });\r\n\r\n      t  = await r.text();\r\n      ct = (r.headers.get('Content-Type')||'').toLowerCase();\r\n      log('POST END', {status:r.status, ok:r.ok, ct, len:t.length});\r\n\r\n      if (!r.ok){\r\n        const e = new Error(`POST ${url} \u2192 ${r.status}.`);\r\n        e.status = r.status;\r\n        try { if (ct.includes('application/json')) e.payload = JSON.parse(t); } catch(_){}\r\n        throw e;\r\n      }\r\n      if (!ct.includes('application/json')){\r\n        const e = new Error(`Respuesta no JSON (${ct||'sin CT'})`);\r\n        e.status = r.status;\r\n        e.payload = { raw: t.slice(0,500) };\r\n        throw e;\r\n      }\r\n      return JSON.parse(t);\r\n\r\n    } finally {\r\n      clearTimeout(tmr);\r\n    }\r\n  })", "is_member_call": false, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L75"}, {"caller_nid": "common_helpers_post_form", "callee": "set", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L120"}, {"caller_nid": "common_helpers_requestwithfallback", "callee": "isArray", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L127"}, {"caller_nid": "common_helpers_requestwithfallback", "callee": "fetch", "is_member_call": false, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L138"}, {"caller_nid": "common_helpers_requestwithfallback", "callee": "includes", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L140"}, {"caller_nid": "common_helpers_requestwithfallback", "callee": "json", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L141"}, {"caller_nid": "common_helpers_requestwithfallback", "callee": "text", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L141"}, {"caller_nid": "common_helpers_requestwithfallback", "callee": "stringify", "is_member_call": true, "source_file": "C:\\xampp3\\htdocs\\TerrenaLaravel\\public\\assets\\js\\common\\helpers.js", "source_location": "L143"}, {"caller_nid": "common_