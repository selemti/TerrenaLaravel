	<subDataset name="FolioDS">
		<parameter name="ticketIdParsed" class="java.lang.String">
			<defaultValueExpression><![CDATA["877"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
  LPAD(COALESCE(t.daily_folio, 0)::text, 3, '0') AS folio_display
FROM public.ticket t
WHERE t.id = CAST($P{ticketIdParsed} AS INTEGER)]]>
		</queryString>
		<field name="folio_display" class="java.lang.String"/>
		<variable name="FOLIO_DISPLAY" class="java.lang.String"/>
	</subDataset>
